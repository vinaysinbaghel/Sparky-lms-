FROM nginx:alpine

# Install bash and openssl for certificate verification and runtime checks
RUN apk add --no-cache bash openssl curl

WORKDIR /var/www/sparky-lms

# Copy application source tree for static file serving and FastCGI script checking
COPY . /var/www/sparky-lms

# Copy Nginx configuration and protected routes
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/sparky-routes.inc /etc/nginx/conf.d/sparky-routes.inc
COPY docker/entrypoint-nginx.sh /usr/local/bin/entrypoint-nginx.sh

# Remove development / sensitive files from the production web container
RUN rm -rf /var/www/sparky-lms/.git \
           /var/www/sparky-lms/.github \
           /var/www/sparky-lms/tests \
           /var/www/sparky-lms/scratch \
           /var/www/sparky-lms/*.md \
           /var/www/sparky-lms/documentation

# Enforce read-only permissions: root:root (755 for dirs, 644 for files)
RUN chown -R root:root /var/www/sparky-lms \
    && find /var/www/sparky-lms -type d -exec chmod 755 {} + \
    && find /var/www/sparky-lms -type f -exec chmod 644 {} + \
    && chmod +x /usr/local/bin/entrypoint-nginx.sh

ENTRYPOINT ["/usr/local/bin/entrypoint-nginx.sh"]
CMD ["nginx", "-g", "daemon off;"]
