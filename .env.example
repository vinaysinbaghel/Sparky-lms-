# ==============================================================================
# Sparky LMS - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. Generate strong, unique passwords for all secret keys below:
#      openssl rand -base64 24
# 3. Never commit your '.env' file to version control.
# ==============================================================================

# Application Host / Domain (e.g. localhost, lms.example.com)
APP_HOST=localhost

# Database Configuration
DB_NAME=sparky_lms
DB_USER=sparky_user

# MANDATORY SECRETS: Docker Compose will refuse to start if these are left unset.
# Generate secure random strings (minimum 16+ characters recommended)
DB_PASSWORD=ChangeMe_StrongDbPassword_2026!
MYSQL_ROOT_PASSWORD=ChangeMe_StrongRootPassword_2026!
REDIS_PASSWORD=ChangeMe_StrongRedisPassword_2026!

# Application Signing Key (Mandatory for signing sessions, hashes, and internal tokens)
# Generate a 64-character hex key (minimum 32 characters required):
#   openssl rand -hex 32
SECURITY_KEY=replace_with_64_character_hex_key_generated_via_openssl_rand_hex_32
