# ==============================================================================
# Sparky LMS - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this template to '.env':
#      cp .env.example .env
# 2. You MUST generate strong, unique random secrets for all mandatory keys below.
#    Docker Compose and entrypoint scripts will refuse to start if these are left
#    empty or match known insecure placeholder strings.
# 3. Never commit your '.env' file to version control.
# ==============================================================================

# Application Host / Domain (e.g. localhost, lms.yourdomain.com)
APP_HOST=localhost

# Database Configuration
DB_NAME=sparky_lms
DB_USER=sparky_user

# ==============================================================================
# MANDATORY SECRETS (NO DEFAULT VALUES - GENERATE SECURE RANDOM STRINGS)
# ==============================================================================

# Database User Password (Minimum 16 characters):
# Generate command: openssl rand -base64 24
DB_PASSWORD=

# Database Root Password (Minimum 16 characters):
# Generate command: openssl rand -base64 24
MYSQL_ROOT_PASSWORD=

# Redis Authentication Password (Minimum 16 characters):
# Generate command: openssl rand -base64 24
REDIS_PASSWORD=

# Application Signing Key (Mandatory for session encryption and CSRF tokens)
# Minimum 32 characters (recommended: 64-character hexadecimal):
# Generate command: openssl rand -hex 32
SECURITY_KEY=
