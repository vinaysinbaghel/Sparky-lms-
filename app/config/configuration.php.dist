<?php
/**
 * Sparky LMS Production Configuration Template
 * Copy this file to app/config/configuration.php and adjust values or set environment variables.
 */

// 1. Database Connection Settings (supports environment variables)
$_configuration['db_host']     = getenv('DB_HOST') ?: '127.0.0.1';
$_configuration['db_port']     = getenv('DB_PORT') ?: '3306';
$_configuration['main_database'] = getenv('DB_NAME') ?: 'sparky_lms';
$_configuration['db_user']     = getenv('DB_USER') ?: 'sparky_user';
$_configuration['db_password'] = getenv('DB_PASSWORD') ?: '';

// 2. Directory & Host Paths
$sysRoot = rtrim(str_replace('\\', '/', realpath(__DIR__ . '/../../')), '/') . '/';
$_configuration['root_sys'] = $sysRoot;

$appHost = getenv('APP_HOST') ?: (isset($_SERVER['HTTP_HOST']) ? $_SERVER['HTTP_HOST'] : 'localhost:8000');
$isHttps = (isset($_SERVER['HTTPS']) && $_SERVER['HTTPS'] === 'on')
    || (isset($_SERVER['HTTP_X_FORWARDED_PROTO']) && $_SERVER['HTTP_X_FORWARDED_PROTO'] === 'https')
    || (isset($_SERVER['HTTP_CF_VISITOR']) && strpos($_SERVER['HTTP_CF_VISITOR'], 'https') !== false);
$scheme = $isHttps ? 'https://' : 'http://';

$_configuration['root_web']   = $scheme . rtrim($appHost, '/') . '/';
$_configuration['url_append'] = '';

// 3. Security & Application Signing Keys
$envSecurityKey = getenv('SECURITY_KEY');
$insecurePlaceholders = [
    'sparky_prod_sec_key_ChangeThisInProduction!',
    'replace_with_64_character_hex_key_generated_via_openssl_rand_hex_32',
    'ChangeMe_StrongDbPassword_2026!',
    'ChangeMe_StrongRootPassword_2026!',
    'ChangeMe_StrongRedisPassword_2026!',
    'Your32CharRandomProductionSecurityKey!',
    '12345678901234567890123456789012',
    'abcdefghijklmnopqrstuvwxyz123456',
];
$isPlaceholder = false;
if (!empty($envSecurityKey)) {
    foreach ($insecurePlaceholders as $placeholder) {
        if (stripos($envSecurityKey, $placeholder) !== false) {
            $isPlaceholder = true;
            break;
        }
    }
    if (preg_match('/^(changeme|replace_with|testpass|your_secret)/i', $envSecurityKey)) {
        $isPlaceholder = true;
    }
}

if (empty($envSecurityKey) || strlen(trim($envSecurityKey)) < 32 || $isPlaceholder) {
    if (PHP_SAPI !== 'cli') {
        http_response_code(500);
        error_log('[Sparky LMS] CRITICAL CONFIGURATION ERROR: SECURITY_KEY is missing, under 32 characters, or contains an insecure placeholder.');
        echo "<h1>Internal Configuration Error</h1><p>Application signing key (SECURITY_KEY) is invalid or using a known placeholder. Please generate a unique secret using `openssl rand -hex 32`.</p>";
        exit(1);
    }
    // In CLI test / development runner without env, set safe deterministic entropy
    $envSecurityKey = 'cli_dev_' . hash('sha256', __DIR__);
}
$_configuration['security_key'] = $envSecurityKey;
$_configuration['password_encryption'] = 'bcrypt';

// 4. Redis Caching & Session Store
$_configuration['redis_host']     = getenv('REDIS_HOST') ?: '127.0.0.1';
$_configuration['redis_port']     = (int)(getenv('REDIS_PORT') ?: 6379);
$_configuration['redis_password'] = getenv('REDIS_PASSWORD') ?: null;
$_configuration['redis_session_db'] = (int)(getenv('REDIS_SESSION_DB') ?: 0);
$_configuration['redis_cache_db']   = (int)(getenv('REDIS_CACHE_DB') ?: 1);

// Configure Redis session handler if phpredis extension is loaded and session is not already active
if (extension_loaded('redis') && !empty($_configuration['redis_host']) && session_status() === PHP_SESSION_NONE) {
    $redisAuth = !empty($_configuration['redis_password']) ? 'auth=' . rawurlencode($_configuration['redis_password']) . '&' : '';
    $savePath = sprintf(
        'tcp://%s:%d?%sdatabase=%d&prefix=sparky_sess:&timeout=2.0',
        $_configuration['redis_host'],
        $_configuration['redis_port'],
        $redisAuth,
        $_configuration['redis_session_db']
    );
    @ini_set('session.save_handler', 'redis');
    @ini_set('session.save_path', $savePath);
}

// 5. System Administration & Platform Defaults
$_configuration['software_name'] = 'Sparky LMS';
$_configuration['system_version'] = '1.0';
$_configuration['institution']   = 'Sparky Learning Platform';
$_configuration['institution_url'] = $_configuration['root_web'];
$_configuration['admin_email']   = getenv('ADMIN_EMAIL') ?: 'admin@sparkylms.com';
$_configuration['admin_name']    = 'Sparky Administrator';

// 6. Security & Session Policy
$_configuration['session_lifetime'] = 86400; // 24 hours
$_configuration['security_session_cookie_samesite_none'] = false;
$_configuration['deny_delete_users'] = false;
